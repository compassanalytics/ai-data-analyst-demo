# AI Data Analyst Demo - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABRICKS CONNECTION
# =============================================================================

# Your Databricks workspace URL (required for non-mock mode)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Personal Access Token (for local development only)
# In Databricks notebooks, authentication is handled automatically
DATABRICKS_TOKEN=your-personal-access-token

# =============================================================================
# GENIE SPACE CONFIGURATION
# =============================================================================

# The Genie Space ID for data analysis queries (required for non-mock mode)
# Find this in your Genie Space URL: /genie/spaces/{GENIE_SPACE_ID}
GENIE_SPACE_ID=your-genie-space-id

# Multiple Genie Spaces (JSON format, optional - for MultiGenieOrchestrator)
# GENIE_SPACES='[{"space_id": "abc123", "name": "Sales Data", "domain": "sales, revenue"}, {"space_id": "def456", "name": "Customer Analytics", "domain": "customers, segments"}]'
GENIE_SPACES=

# SQL Warehouse ID (optional, uses Genie Space default if not specified)
WAREHOUSE_ID=your-warehouse-id

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model serving endpoint for LLM (ChatDatabricks)
# Default: databricks-meta-llama-3-3-70b-instruct
MODEL_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# LLM Configuration (for benchmark system)
LLM_PROVIDER=litellm                    # LLM provider: litellm, databricks
LLM_MODEL=databricks-meta-llama-3-3-70b-instruct  # Model name for LLM operations

# =============================================================================
# VECTOR SEARCH CONFIGURATION (for RAG Agent)
# =============================================================================

# Vector Search endpoint name
# Create via: scripts/setup_vector_search.py
VECTOR_SEARCH_ENDPOINT=rag-demo-endpoint

# Vector Search index name (full path: catalog.schema.index)
VECTOR_SEARCH_INDEX=workspace.rag_demo.document_index

# Embedding model endpoint for managed embeddings
# Default: databricks-bge-large-en (Foundation Model API)
EMBEDDING_ENDPOINT=databricks-bge-large-en

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable mock mode for testing without Databricks access
# Set to 'true' to use mock responses for Genie and RAG
MOCK_MODE=false

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Enable query result caching (default: true)
CACHE_ENABLED=true

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Maximum cache entries (default: 1000)
CACHE_MAX_SIZE=1000

# Demo mode: normal, fast, or live
# - normal: Standard caching behavior
# - fast: Aggressive caching (longer TTL for demos)
# - live: No caching (always fetch fresh data)
DEMO_MODE=normal

# =============================================================================
# ERROR HANDLING (optional - defaults shown)
# =============================================================================
# DEFAULT_MAX_RETRIES=3
# DEFAULT_RETRY_BASE_DELAY=1.0
# DEFAULT_RETRY_MAX_DELAY=30.0
# DEFAULT_TIMEOUT_SECONDS=120
# CIRCUIT_BREAKER_ENABLED=false
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT_SECONDS=60.0
