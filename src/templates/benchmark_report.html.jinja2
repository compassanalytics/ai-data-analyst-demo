<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .improvement { color: #059669; }
        .regression { color: #dc2626; }
        .unchanged { color: #6b7280; }
        .delta-positive { background-color: #d1fae5; color: #065f46; }
        .delta-negative { background-color: #fee2e2; color: #991b1b; }
        .delta-neutral { background-color: #f3f4f6; color: #374151; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Header -->
        <header class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">{{ title }}</h1>
            <p class="text-gray-500 mt-2">Generated: {{ generated_at }}</p>
        </header>

        <!-- Executive Summary Cards -->
        <section class="mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Executive Summary</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <!-- Overall Accuracy Delta -->
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500 text-sm">Accuracy Change</span>
                        <span class="px-2 py-1 text-xs font-semibold rounded {% if accuracy_delta > 0 %}delta-positive{% elif accuracy_delta < 0 %}delta-negative{% else %}delta-neutral{% endif %}">
                            {{ accuracy_delta | format_delta }}
                        </span>
                    </div>
                    <div class="mt-2">
                        <span class="text-2xl font-bold {% if accuracy_delta > 0 %}text-green-600{% elif accuracy_delta < 0 %}text-red-600{% else %}text-gray-600{% endif %}">
                            {{ enhanced.summary.overall_accuracy | format_percent }}
                        </span>
                        <span class="text-gray-400 text-sm ml-2">from {{ baseline.summary.overall_accuracy | format_percent }}</span>
                    </div>
                </div>

                <!-- Improvements -->
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500 text-sm">Improvements</span>
                        <span class="p-2 rounded-full bg-green-100 text-green-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="mt-2">
                        <span class="text-2xl font-bold text-green-600">{{ improvements | length }}</span>
                        <span class="text-gray-400 text-sm ml-2">queries</span>
                    </div>
                </div>

                <!-- Regressions -->
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500 text-sm">Regressions</span>
                        <span class="p-2 rounded-full {% if regressions | length > 0 %}bg-red-100 text-red-600{% else %}bg-gray-100 text-gray-400{% endif %}">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="mt-2">
                        <span class="text-2xl font-bold {% if regressions | length > 0 %}text-red-600{% else %}text-gray-400{% endif %}">{{ regressions | length }}</span>
                        <span class="text-gray-400 text-sm ml-2">queries</span>
                    </div>
                </div>

                <!-- Total Queries -->
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500 text-sm">Total Queries</span>
                        <span class="p-2 rounded-full bg-blue-100 text-blue-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="mt-2">
                        <span class="text-2xl font-bold text-gray-700">{{ total_queries }}</span>
                        <span class="text-gray-400 text-sm ml-2">evaluated</span>
                    </div>
                </div>
            </div>
        </section>

        {% if has_regressions %}
        <!-- Warning Banner -->
        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-8">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-red-700">
                        <strong>Warning:</strong> {{ regressions | length }} queries regressed in the enhanced run. Review these queries to understand what may have caused the regression.
                    </p>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Comparison Table -->
        <section class="mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Detailed Comparison</h2>
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Metric</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Baseline</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Enhanced</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Delta</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Overall Accuracy</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ baseline.summary.overall_accuracy | format_percent }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ enhanced.summary.overall_accuracy | format_percent }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 py-1 text-xs font-semibold rounded {% if accuracy_delta > 0 %}delta-positive{% elif accuracy_delta < 0 %}delta-negative{% else %}delta-neutral{% endif %}">
                                    {{ accuracy_delta | format_delta }}
                                </span>
                            </td>
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Correct</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ baseline.summary.correct_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ enhanced.summary.correct_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set correct_delta = enhanced.summary.correct_count - baseline.summary.correct_count %}
                                <span class="{% if correct_delta > 0 %}improvement{% elif correct_delta < 0 %}regression{% else %}unchanged{% endif %}">
                                    {% if correct_delta > 0 %}+{% endif %}{{ correct_delta }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Partial</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ baseline.summary.partial_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ enhanced.summary.partial_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set partial_delta = enhanced.summary.partial_count - baseline.summary.partial_count %}
                                <span class="unchanged">
                                    {% if partial_delta > 0 %}+{% endif %}{{ partial_delta }}
                                </span>
                            </td>
                        </tr>
                        <tr class="bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Wrong</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ baseline.summary.wrong_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ enhanced.summary.wrong_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set wrong_delta = baseline.summary.wrong_count - enhanced.summary.wrong_count %}
                                <span class="{% if wrong_delta > 0 %}improvement{% elif wrong_delta < 0 %}regression{% else %}unchanged{% endif %}">
                                    {% if wrong_delta > 0 %}+{% endif %}{{ wrong_delta }} (lower is better)
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Failed</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ baseline.summary.failed_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ enhanced.summary.failed_count }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                {% set failed_delta = baseline.summary.failed_count - enhanced.summary.failed_count %}
                                <span class="{% if failed_delta > 0 %}improvement{% elif failed_delta < 0 %}regression{% else %}unchanged{% endif %}">
                                    {% if failed_delta > 0 %}+{% endif %}{{ failed_delta }} (lower is better)
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Category Improvements -->
        <section class="mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Improvement by Failure Category</h2>
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Improvement</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        {% for category, improvement in category_improvements.items() %}
                        <tr class="{% if loop.index is odd %}bg-white{% else %}bg-gray-50{% endif %}">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ category | replace('_', ' ') | title }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 py-1 text-xs font-semibold rounded {% if improvement > 0 %}delta-positive{% elif improvement < 0 %}delta-negative{% else %}delta-neutral{% endif %}">
                                    {{ improvement | format_delta }}
                                </span>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Query Changes -->
        <section class="mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Query-Level Changes</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Improvements -->
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="text-lg font-medium text-green-600 mb-3">Improvements ({{ improvements | length }})</h3>
                    {% if improvements %}
                    <ul class="space-y-1 max-h-64 overflow-y-auto">
                        {% for query_id in improvements %}
                        <li class="text-sm text-gray-600 font-mono bg-green-50 px-2 py-1 rounded">{{ query_id }}</li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="text-sm text-gray-400">No queries improved.</p>
                    {% endif %}
                </div>

                <!-- Regressions -->
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="text-lg font-medium text-red-600 mb-3">Regressions ({{ regressions | length }})</h3>
                    {% if regressions %}
                    <ul class="space-y-1 max-h-64 overflow-y-auto">
                        {% for query_id in regressions %}
                        <li class="text-sm text-gray-600 font-mono bg-red-50 px-2 py-1 rounded">{{ query_id }}</li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="text-sm text-gray-400">No regressions detected.</p>
                    {% endif %}
                </div>

                <!-- Unchanged -->
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="text-lg font-medium text-gray-600 mb-3">Unchanged ({{ unchanged | length }})</h3>
                    {% if unchanged %}
                    <ul class="space-y-1 max-h-64 overflow-y-auto">
                        {% for query_id in unchanged %}
                        <li class="text-sm text-gray-500 font-mono bg-gray-50 px-2 py-1 rounded">{{ query_id }}</li>
                        {% endfor %}
                    </ul>
                    {% else %}
                    <p class="text-sm text-gray-400">All queries changed.</p>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- Run Details -->
        <section class="mb-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Run Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="text-lg font-medium text-gray-700 mb-3">Baseline Run</h3>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Run ID</dt>
                            <dd class="text-gray-900 font-mono">{{ baseline.run_id }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Space ID</dt>
                            <dd class="text-gray-900 font-mono">{{ baseline.space_id }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Queries</dt>
                            <dd class="text-gray-900">{{ baseline.queries_evaluated }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Started</dt>
                            <dd class="text-gray-900">{{ baseline.started_at }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Completed</dt>
                            <dd class="text-gray-900">{{ baseline.completed_at }}</dd>
                        </div>
                    </dl>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="text-lg font-medium text-gray-700 mb-3">Enhanced Run</h3>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Run ID</dt>
                            <dd class="text-gray-900 font-mono">{{ enhanced.run_id }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Space ID</dt>
                            <dd class="text-gray-900 font-mono">{{ enhanced.space_id }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Queries</dt>
                            <dd class="text-gray-900">{{ enhanced.queries_evaluated }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Started</dt>
                            <dd class="text-gray-900">{{ enhanced.started_at }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-gray-500">Completed</dt>
                            <dd class="text-gray-900">{{ enhanced.completed_at }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="text-center text-gray-400 text-sm mt-8 pt-8 border-t">
            <p>Report generated by Benchmark System</p>
            <p>Comparison ID: {{ comparison.comparison_id }}</p>
        </footer>
    </div>
</body>
</html>
